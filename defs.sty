% useful color schemes
% names from https://www.overleaf.com/learn/latex/Using_colors_in_LaTeX
\newcommand{\todo}[1]{\textcolor{red}{#1}}
\newcommand{\tocheck}[1]{\textcolor{red}{#1}}
% color schemes for individuals
\newcommand{\ab}[1]{\textcolor{OliveGreen}{#1}}
\newcommand{\lc}[1]{\textcolor{Magenta}{#1}}

\newcommand{\HT}{$H_{\mathrm{T}}$}
\newcommand{\pT}{$p_{\mathrm{T}}$}
\newcommand{\sqrtsNN}{\mbox{$\sqrt{s_{\mathrm{NN}}}$}}
\newcommand {\roots}{\mbox{$\sqrt{s}$}}
\newcommand{\GeV}{GeV}
\newcommand{\TeV}{TeV}
\def\pp{\ensuremath{pp}\xspace}
\def\ee{\ensuremath{e^+e^-}\xspace}
\def\qq{\ensuremath{q\bar{{q}}}\xspace}

% units
\newcommand*{\ifb}{\mbox{fb\(^{-1}\)}\xspace}
\newcommand*{\ipb}{\mbox{pb\(^{-1}\)}\xspace}
\newcommand*{\inb}{\mbox{nb\(^{-1}\)}\xspace}

% pwflag style plots
\newcommand{\pwpanel}[3][0.32]{%
  \begin{subfigure}[b]{#1\textwidth}%
    \includegraphics[width=\textwidth]{figures/#2_#3.pdf}%
    \caption{}\label{fig:#2_#3}%
  \end{subfigure}
}

% subfig env
\newcommand{\sfpanel}[2][0.32]{%
  \begin{subfigure}[b]{#1\textwidth}%
    \includegraphics[width=\textwidth]{figures/#2.pdf}%
    \caption{}\label{fig:#2}%
  \end{subfigure}%
}