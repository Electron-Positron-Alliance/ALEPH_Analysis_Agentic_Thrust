% ---- EPA logo block ------------------------------------------------
% Usage: \eelogo  (place right after \begin{document}, before \maketitle)
\newcommand{\eelogo}{%
  \AddToShipoutPictureBG*{%
    \put(\LenToUnit{\dimexpr 1in+\oddsidemargin\relax},\LenToUnit{18mm}){%
      \begin{minipage}[c]{15mm}%
        \includegraphics[width=\textwidth]{figures/ee-logo.pdf}%
      \end{minipage}%
      \hspace{4mm}%
      \raisebox{-1mm}[0pt][0pt]{%
        \begin{minipage}[c]{0.7\textwidth}%
          \Large
          Electron--Positron Alliance\\
          \url{https://ee-alliance.org/home/}%
        \end{minipage}}}}%
}
